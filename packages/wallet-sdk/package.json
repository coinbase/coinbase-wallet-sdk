{
  "name": "@coinbase/wallet-sdk",
  "version": "5.0.0",
  "description": "Coinbase Wallet SDK",
  "keywords": [
    "base",
    "account",
    "sdk",
    "web3"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/coinbase-wallet-sdk.min.js",
  "jsdelivr": "dist/coinbase-wallet-sdk.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui-assets": {
      "types": "./dist/ui/assets/index.d.ts",
      "import": "./dist/ui/assets/index.js",
      "require": "./dist/ui/assets/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": "https://github.com/coinbase/coinbase-wallet-sdk.git",
  "author": "Coinbase",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist && rm -rf node_modules",
    "pretest": "node compile-assets.cjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prebuild": "rm -rf ./dist",
    "build": "node compile-assets.cjs && tsc -p ./tsconfig.build.json && tsc-alias && yarn build:browser",
    "build:browser": "rolldown -c rolldown.config.js",
    "prepublishOnly": "yarn build",
    "dev": "yarn build && tsc --watch & nodemon --watch dist --delay 1 --exec tsc-alias",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "format:check": "biome check . --formatter-enabled=true --linter-enabled=false --organize-imports-enabled=false",
    "size": "size-limit"
  },
  "dependencies": {
    "@solana/wallet-standard-features": "1.3.0",
    "@wallet-standard/app": "1.1.0",
    "@wallet-standard/base": "1.1.0",
    "@wallet-standard/features": "1.1.0",
    "@wallet-standard/wallet": "1.1.0",
    "clsx": "1.2.1",
    "eventemitter3": "5.0.1",
    "idb-keyval": "6.2.1",
    "ox": "0.6.9",
    "preact": "10.24.2",
    "viem": "^2.31.7",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@size-limit/preset-big-lib": "^11.1.6",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^14.18.54",
    "@vitest/coverage-v8": "^3.2.5",
    "@vitest/web-worker": "3.2.1",
    "fake-indexeddb": "^6.0.0",
    "glob": "^11.0.0",
    "jest-websocket-mock": "^2.4.0",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.0",
    "rolldown": "^1.2.14",
    "sass": "^1.64.1",
    "size-limit": "^11.1.6",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.1.6",
    "vitest": "^3.2.5"
  },
  "size-limit": [
    {
      "path": "./dist/index.js",
      "limit": "31 KB",
      "import": "*"
    }
  ]
}
